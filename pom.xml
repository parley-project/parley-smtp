<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-smtp</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Parley SMTP</name>
	<description>An SMTP server and mail transfer agent (RFC 5321) with a persistent relay queue,
		local delivery into the parley-mail store, and DKIM, SPF, DMARC and ARC.
		Built on parley-net, with DNS from parley-dns. Split out of us.bringardner:bjl_email.</description>
	<inceptionYear>2026</inceptionYear>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.smtp</parley.moduleName>
		<junit.version>5.11.4</junit.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<!-- Small heap on purpose: message bodies must stay out of memory. -->
						<argLine>-Xmx64m</argLine>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- GitHub Packages, used by release.sh. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/parley-smtp</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<!-- Messages, and the mail store LocalDelivery writes to -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-mail</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Server, client, sessions, TLS, authentication -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-net</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- ParleyDnsMxResolver (MX lookups for the queue) and the DKIM, SPF, DMARC and ARC lookups -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-dns</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>

		<!-- Tests only: TestSmtpServer reuses TestPop3Server's keystore helper (from the tests jar) -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-pop3</artifactId>
			<version>1.0.0-SNAPSHOT</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-pop3</artifactId>
			<version>1.0.0-SNAPSHOT</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<!-- reads the RFC 7208 (SPF) and ARC test suites in src/test/resources -->
		<dependency>
			<groupId>org.yaml</groupId>
			<artifactId>snakeyaml</artifactId>
			<version>2.3</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
